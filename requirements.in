# Dependencias DIRECTAS de producción, con rango.
#
# El árbol completo, fijado y con resúmenes, es requirements.txt: lo genera
# `make lock` (pip-compile --generate-hashes) y es a la vez lo que instala la
# imagen (`pip install --require-hashes`) y lo que audita la CI. Sin ese fichero
# no hay «auditar lo que se despliega»: con rangos, la imagen resolvería el árbol
# en el momento de construirse, y la auditoría habría mirado otro.
fastapi>=0.141
uvicorn>=0.52
pydantic>=2.13
pydantic-settings>=2.15
