# ===================================================
# FR Commercial — variables que lee el servicio
#
# Este fichero NO lo lee el servicio: la configuración entra por el entorno del
# proceso. Sirve para `set -a; . ./.env; set +a` al ejecutarlo fuera de Docker.
# Con `docker compose -f docker-compose.dev.yml` no hace falta: el compose fija
# lo necesario.
#
# Es el ÚNICO ejemplo del repositorio, y no lleva ningún valor que pueda
# copiarse tal cual (TFM-MIS-MEM/docs#100).
# ===================================================

# SIN valor, a propósito. El servicio RECHAZA ARRANCAR si falta, si está en
# blanco o si no nombra la base de datos. Fuera de Docker, apunte al MongoDB que
# docker-compose.dev.yml publica en el bucle local, con el nombre de base que
# fija ese mismo fichero.
MONGODB_URI=

# debug | info | warning | error. Por omisión, info.
LOG_LEVEL=info

# Solo para las pruebas: un SERVIDOR MongoDB, sin base de datos. Cada sesión de
# pruebas crea la suya y la borra al acabar. Es una variable distinta de
# MONGODB_URI para que unas pruebas que borran su base no puedan apuntar a la de
# desarrollo por reutilizar la variable.
TEST_MONGODB_URI=
